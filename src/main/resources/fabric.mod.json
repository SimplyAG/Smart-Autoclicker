{
	"schemaVersion": 1,
	"id": "smart-autoclicker",
	"version": "${version}",
	"name": "Smart Autoclicker",
	"description": "Smart AFK automation: auto attack with perfect swing timing, smart auto eat, hold clicks, auto walk, mob sweep and elytra cruise. Alt-tab safe, with toasts and a HUD.",
	"authors": [
		"SimplyAG"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/smart-autoclicker",
		"sources": "https://github.com/SimplyAG/Smart-Autoclicker",
		"issues": "https://github.com/SimplyAG/Smart-Autoclicker/issues"
	},
	"license": "MIT",
	"icon": "assets/smart-autoclicker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.simplyag.autoclicker.AutoClickerClient"
		],
		"modmenu": [
			"com.simplyag.autoclicker.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"smart-autoclicker.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_floor}",
		"minecraft": ["${minecraft_dep}"],
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
